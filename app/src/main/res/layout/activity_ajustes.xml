<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============================== -->
    <!--Imagen de fondo-->
    <!-- ============================== -->
    <ImageView
        android:id="@+id/bgAjustes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.8"
        android:scaleType="centerCrop"
        android:src="@drawable/textura"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ============================== -->
    <!--PANEL-->
    <!-- ============================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/panelAjustes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:padding="20dp"
        android:background="@drawable/fondo_resultados"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloAjustes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ajustes"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/boton"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Nombre -->
        <TextView
            android:id="@+id/tvNombreUsuarioLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textStyle="bold"
            android:textColor="@color/text"
            app:layout_constraintTop_toBottomOf="@id/tvTituloAjustes"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <EditText
            android:id="@+id/etNombreUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nombre usuario"
            android:padding="10dp"
            android:background="@android:drawable/edit_text"
            app:layout_constraintBaseline_toBaselineOf="@id/tvNombreUsuarioLabel"
            app:layout_constraintStart_toEndOf="@id/tvNombreUsuarioLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="12dp"/>

        <!-- Imagen -->
        <TextView
            android:id="@+id/tvImagenLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Imagen"
            android:textStyle="bold"
            android:textColor="@color/text"
            app:layout_constraintTop_toBottomOf="@id/etNombreUsuario"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <ImageView
            android:id="@+id/imgAvatarPreview"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar1"
            app:layout_constraintTop_toTopOf="@id/tvImagenLabel"
            app:layout_constraintBottom_toBottomOf="@id/tvImagenLabel"
            app:layout_constraintStart_toEndOf="@id/tvImagenLabel"
            android:layout_marginStart="16dp"/>

        <Button
            android:id="@+id/btnCambiarImagen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cambiar"
            android:backgroundTint="@color/boton"
            app:layout_constraintTop_toTopOf="@id/imgAvatarPreview"
            app:layout_constraintBottom_toBottomOf="@id/imgAvatarPreview"
            app:layout_constraintStart_toEndOf="@id/imgAvatarPreview"
            android:layout_marginStart="16dp"/>

        <!-- Unidad temperatura -->
        <TextView
            android:id="@+id/tvUnidadTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unidad temperatura"
            android:textStyle="bold"
            android:textColor="@color/text"
            app:layout_constraintTop_toBottomOf="@id/tvImagenLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="30dp"/>

        <RadioGroup
            android:id="@+id/rgTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="@id/tvUnidadTemp"
            app:layout_constraintBottom_toBottomOf="@id/tvUnidadTemp"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/rbC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C°"
                android:textColor="@color/text"/>

            <RadioButton
                android:id="@+id/rbF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F°"
                android:textColor="@color/text"/>
        </RadioGroup>

        <!-- Mostrar/Ocultar -->
        <TextView
            android:id="@+id/tvMostrarOcultar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mostrar/Ocultar"
            android:textStyle="bold"
            android:textColor="@color/text"
            app:layout_constraintTop_toBottomOf="@id/tvUnidadTemp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp"/>

        <CheckBox
            android:id="@+id/cbViento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viento"
            android:textColor="@color/text"
            app:layout_constraintTop_toBottomOf="@id/tvMostrarOcultar"
            app:layout_constraintStart_toStartOf="parent"/>

        <CheckBox
            android:id="@+id/cbCielo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cielo"
            android:textColor="@color/text"
            app:layout_constraintTop_toBottomOf="@id/cbViento"
            app:layout_constraintStart_toStartOf="parent"/>

        <CheckBox
            android:id="@+id/cbLluvia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lluvia"
            android:textColor="@color/text"
            app:layout_constraintTop_toBottomOf="@id/cbCielo"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Botones -->
        <LinearLayout
            android:id="@+id/llBotonesAjustes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@id/cbLluvia"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnGuardarAjustes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardar"
                android:backgroundTint="@color/boton"/>

            <Space
                android:layout_width="20dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnSalirAjustes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salir"
                android:backgroundTint="@color/boton"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

